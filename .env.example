# SERVER ONLY. Copy this file to .env.local and edit privately in your editor.
# Never use live credentials or VITE_ prefixes. Do not commit .env.local.
ROQQU_MODE=test
# Confirmed by Roqqu for Test-mode requests with x-staging-api-key only.
ROQQU_TEST_BASE_URL=https://service.roqqu.com/v1
# Enter the organizers' original Test Private Key privately in .env.local.
# Never put the Live Private Key here. No public key is currently used.
ROQQU_TEST_API_KEY=
# Configure only after Roqqu confirms this receiving route for Test mode.
ROQQU_TEST_TOKEN=USDC
ROQQU_TEST_NETWORK=
ROQQU_TEST_CUSTOMER_EMAIL=
ROQQU_TEST_CUSTOMER_FIRST_NAME=
ROQQU_TEST_CUSTOMER_LAST_NAME=
# After approved wallet creation, copy the returned Test address here privately.
# This does not imply authenticated connectivity or a credited balance.
ROQQU_TEST_RECEIVE_ADDRESS=
# Persistent demo storage (server only). Local defaults to .data/ravenpay.sqlite.
# Vercel REQUIRES a remote libSQL/Turso database; local disk is never used there.
DEMO_DATABASE_URL=
DEMO_DATABASE_AUTH_TOKEN=
# Optional local-only path:
DEMO_SQLITE_PATH=.data/ravenpay.sqlite
